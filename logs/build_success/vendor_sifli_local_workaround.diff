+# VelaBridge local workaround: do not turn SiFli HAL header warnings into build-stopping errors during diagnosis.
+CFLAGS += -Wno-error -Wno-error=strict-prototypes -Wno-error=return-type
+CPPFLAGS += -Wno-error
