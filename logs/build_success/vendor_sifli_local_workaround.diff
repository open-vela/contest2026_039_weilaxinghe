@@ -30,6 +30,19 @@ ARCHSCRIPT += $(BOARD_DIR)$(DELIM)scripts$(DELIM)ld.script
 
 ARCHPICFLAGS = -fpic
 
+# VelaBridge local workaround: board-level SiFli HAL/CMSIS include paths
+# for sf32lb52_lchspi_ulp openvela build diagnosis. Do not submit upstream.
+SIFLI_VENDOR_DIR = $(TOPDIR)$(DELIM)..$(DELIM)vendor$(DELIM)sifli
+ARCHDEFINES += -DSOC_BF0_HCPU=1 -DSF32LB52X=1 -DUSE_HAL_DRIVER=1 -DHAL_TICK_PER_SECOND=1000
+ARCHINCLUDES += ${INCDIR_PREFIX}$(SIFLI_VENDOR_DIR)$(DELIM)chips$(DELIM)drivers$(DELIM)Include
+ARCHINCLUDES += ${INCDIR_PREFIX}$(SIFLI_VENDOR_DIR)$(DELIM)chips$(DELIM)drivers$(DELIM)cmsis$(DELIM)Include
+ARCHINCLUDES += ${INCDIR_PREFIX}$(SIFLI_VENDOR_DIR)$(DELIM)chips$(DELIM)drivers$(DELIM)cmsis$(DELIM)sf32lb52x
+ARCHINCLUDES += ${INCDIR_PREFIX}$(SIFLI_VENDOR_DIR)$(DELIM)chips$(DELIM)external$(DELIM)CMSIS$(DELIM)Include
+ARCHINCLUDES += ${INCDIR_PREFIX}$(SIFLI_VENDOR_DIR)$(DELIM)chips$(DELIM)sf32lb52
+ARCHINCLUDES += ${INCDIR_PREFIX}$(SIFLI_VENDOR_DIR)$(DELIM)chips$(DELIM)sf32lb52$(DELIM)include
+ARCHINCLUDES += ${INCDIR_PREFIX}$(SIFLI_VENDOR_DIR)$(DELIM)chips$(DELIM)boards$(DELIM)include
+ARCHINCLUDES += ${INCDIR_PREFIX}$(SIFLI_VENDOR_DIR)$(DELIM)chips$(DELIM)boards$(DELIM)include$(DELIM)config$(DELIM)sf32lb52x
+ARCHINCLUDES += ${INCDIR_PREFIX}$(SIFLI_VENDOR_DIR)$(DELIM)boards$(DELIM)sf32lb52$(DELIM)sf32lb52_lchspi_ulp$(DELIM)include
 CFLAGS := $(ARCHCFLAGS) $(ARCHOPTIMIZATION) $(ARCHCPUFLAGS) $(ARCHINCLUDES) $(ARCHDEFINES) $(EXTRAFLAGS) -pipe -Werror=return-type -Werror
 CPICFLAGS = $(ARCHPICFLAGS) $(CFLAGS)
 CXXFLAGS := $(ARCHCXXFLAGS) $(ARCHOPTIMIZATION) $(ARCHCPUFLAGS) $(ARCHXXINCLUDES) $(ARCHDEFINES) $(EXTRAFLAGS) -pipe
@@ -38,3 +51,7 @@ CPPFLAGS := $(ARCHINCLUDES) $(ARCHDEFINES) $(EXTRAFLAGS)
