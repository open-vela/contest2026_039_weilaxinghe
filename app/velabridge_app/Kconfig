config LVX_USE_DEMO_CONTEST2026_039_VELABRIDGE_APP
	bool "Contest 2026 team 039 VelaBridge app"
	default n
	---help---
		Enable the VelaBridge device-side state machine skeleton.

if LVX_USE_DEMO_CONTEST2026_039_VELABRIDGE_APP

config LVX_USE_DEMO_CONTEST2026_039_VELABRIDGE_APP_STACKSIZE
	int "VelaBridge app stack size"
	default 12288
	---help---
		Stack size for the VelaBridge watch UI app. LVGL's NuttX
		backend requires at least 8192 bytes, so the default keeps
		extra headroom for the display-only demo loop.

endif
