	default n
	select LV_FONT_SIMSUN_16_CJK if GRAPHICS_LVGL
	select LV_FONT_MONTSERRAT_28 if GRAPHICS_LVGL
	select LV_FONT_MONTSERRAT_48 if GRAPHICS_LVGL
	---help---
